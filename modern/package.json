{
  "name": "life100-modern",
  "private": true,
  "type": "module",
  "version": "3.0.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "gateway:dev": "wrangler dev",
    "gateway:deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src worker e2e vite.config.ts playwright.config.ts --max-warnings 0",
    "format": "prettier --write src worker e2e *.ts *.json *.mjs",
    "format:check": "prettier --check src worker e2e *.ts *.json *.mjs",
    "test:e2e": "playwright test",
    "audit": "npm audit --audit-level=high",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "lucide-react": "^1.75.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "fuse.js": "^7.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.5",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1",
    "vite-plugin-pwa": "^2.0.0",
    "wrangler": "^4.0.0",
    "eslint": "^9.39.4",
    "@eslint/js": "^9.39.4",
    "typescript-eslint": "^8.62.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.6.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/dom": "^10.4.1",
    "@playwright/test": "^1.60.0",
    "jsdom": "^27.0.0",
    "@types/node": "^24.0.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
